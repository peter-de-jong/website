---
import '@fontsource/eb-garamond/latin-400.css';
import '@fontsource/eb-garamond/latin-400-italic.css';
import '@fontsource/eb-garamond/latin-600.css';
// Stand-in for Peter's handwriting font until his Calligraphr font is ready.
import '@fontsource/caveat/latin-500.css';
import '../styles/global.css';
import DemoGate from '../components/DemoGate.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = 'Peter Dejong',
  description = 'Werk van Peter Dejong: schilderijen, performances en meer.',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <!-- Temporary PIN screen for the demo period; remove at launch -->
    <DemoGate />
    <slot />
  </body>
</html>
