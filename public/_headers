# deploybase custom headers (Netlify syntax). Later rules override earlier ones,
# so the broad rule comes first.

# HTML and other non-fingerprinted files: always revalidate, so updates show immediately.
# X-Robots-Tag keeps search engines out until launch (remove in Phase 9).
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex, nofollow

# Fingerprinted by Astro (CSS, JS, fonts, design images): safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Project photos: content-hashed filenames written by /beheer or scripts/import-image.mjs.
/media/*
  Cache-Control: public, max-age=31536000, immutable
